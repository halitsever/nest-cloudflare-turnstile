{
  "name": "nest-cloudflare-turnstile",
  "version": "0.0.18",
  "description": "🔥 Cloudflare Turnstile integration for NestJS",
  "keywords": [
    "nestjs",
    "nest",
    "cloudflare",
    "turnstile",
    "captcha",
    "guard",
    "bot-protection"
  ],
  "homepage": "https://halitsever.github.io/nest-cloudflare-turnstile",
  "bugs": {
    "url": "https://github.com/halitsever/nest-cloudflare-turnstile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halitsever/nest-cloudflare-turnstile.git"
  },
  "license": "MIT",
  "author": "Halit Sever <halitsever@protonmail.com>",
  "type": "commonjs",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "lint:package": "publint && attw --pack .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.mts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "prepack": "npm run build",
    "release": "changelogen --release"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.20",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "changelogen": "^0.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-swc": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  }
}
